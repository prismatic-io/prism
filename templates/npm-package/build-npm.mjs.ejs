import { mkdtemp, rm, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { build } from "tsdown";

// Keep src/index.ts and the component's tests unchanged. A temporary build entry
// adapts the conventional component export using Spectral's retained authoring data.
// It lives inside the project so TypeScript resolves the project's dependencies.
const directory = await mkdtemp(join(process.cwd(), ".prism-npm-"));
try {
  const entry = join(directory, "index.ts");
  await writeFile(entry, [
    'import { callableComponent } from "@prismatic-io/spectral";',
    'import component from "../src/index";',
    'export default callableComponent(component);',
    "",
  ].join("\n"));
  await build({
    config: false,
    entry: { index: entry },
    format: ["cjs"],
    platform: "node",
    target: "node22",
    outDir: "npm-dist",
    clean: true,
    // Resolve declaration imports as TypeScript does (including Axios ESM types).
    dts: { resolver: "tsc" },
    fixedExtension: true,
    // Spectral must remain external so consumers supply the execution context.
    copy: [{ from: "assets/**/*", to: "npm-dist", flatten: false }],
  });
} finally {
  await rm(directory, { recursive: true, force: true });
}
