<% if (npmPackage) { -%>
/**
 * The npm entrypoint: a code-native integration that installs this package calls the
 * component's actions, triggers and data sources in-process, and declares its connections
 * from the component's definitions. `src/platform.ts` is the entry Prismatic publishes.
 */
import { callableComponent } from "@prismatic-io/spectral";
import built from "./definition";

export default callableComponent(built);
<% } else { -%>
/**
 * This project defines a custom connector that you can use
 * in the low-code integration designer. To run unit tests
 * of this connector locally, run "npm run test".
 *
 * To publish this connector for use in the low-code designer,
 * run "npm run build" and then "prism components:publish".
 *
 * For information on custom connectors, see
 * https://prismatic.io/docs/custom-connectors/
 */

import { component } from "@prismatic-io/spectral";
import actions from "./actions";
import triggers from "./triggers";
import dataSources from "./dataSources";
import connections from "./connections";

export default component({
  key: "<%= component.key %>",
<% if (component.public) { -%>
  public: true,
  documentationUrl: "https://prismatic.io/docs/components/<%= component.key %>/",
<% } else { -%>
  public: false,
<% } -%>
  display: {
    label: "<%= component.name %>",
    description: "<%= component.description %>",
<% if (component.public) { -%>
    category: "Application Connectors",
<% } -%>
    iconPath: "icon.png",
  },
  actions,
  triggers,
  dataSources,
  connections,
});
<% } -%>
