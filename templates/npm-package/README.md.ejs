### Using the component

<% if (example) { -%>
```ts
import { configPage, flow } from "@prismatic-io/spectral";
import <%= importName %> from "<%= packageName %>";

export const configPages = {
  Configuration: configPage({
    elements: {
      // A connection config var, backed by the published component's connection.
      "My Connection": <%= importName %>.connections.<%= example.connection %>({ stableKey: "my-connection" }),
      // A data source config var, run in-process; its inputs bind like a trigger's.
      "My Choice": <%= importName %>.dataSources.<%= example.dataSource %>({
        stableKey: "my-choice",
        values: { <%= example.connectionInput %>: { configVar: "My Connection" } },
      }),
    },
  }),
};

export const myFlow = flow({
  name: "My Flow",
  stableKey: "my-flow",
  // A component trigger bound to the flow. A `configVar` binding is read on each invocation;
  // other inputs take their pre-clean values.
  onTrigger: <%= importName %>.triggers.<%= example.trigger %>({ <%= example.connectionInput %>: { configVar: "My Connection" } }),
  onExecution: async (context) => ({
    data: await <%= importName %>.actions.<%= example.action %>({
      <%= example.connectionInput %>: context.configVars["My Connection"],
      // ...the action's other inputs, typed from its definition
    }),
  }),
});
```

A data source can also be called directly,
`await <%= importName %>.dataSources.<%= example.dataSource %>.perform({ ... })`, from a
`dataSourceConfigVar`'s `perform`.
<% } else { -%>
Import the package's default export to reach the component's callable actions,
triggers, data sources and connection factories:

```ts
import <%= importName %> from "<%= packageName %>";

// Inside a flow's onExecution
const result = await <%= importName %>.actions.<actionKey>({
  // ...the action's inputs, typed from its definition
});
```
