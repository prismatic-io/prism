{
  "name": "@prismatic-io/prism",
  "version": "11.0.0",
  "description": "Build, deploy, and support integrations in Prismatic from the comfort of your command line",
  "keywords": [
    "prismatic",
    "cli"
  ],
  "homepage": "https://prismatic.io",
  "bugs": {
    "url": "https://github.com/prismatic-io/prism"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/prism.git"
  },
  "license": "MIT",
  "bin": {
    "prism": "lib/run.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf lib && bun run clean-test-temp",
    "clean-test-temp": "rm -rf src/commands/components/temp src/commands/components/init/temp",
    "build": "bun run clean && bun run format && bun run lint && tsc && bun run bundle && bun run test:cli",
    "bundle": "bun run build.ts",
    "bundle:debug": "bun run build.ts --debug",
    "prepack": "bun run build",
    "lint": "biome lint .",
    "lint-fix": "biome lint --write --unsafe .",
    "format": "bun run lint-fix && biome format --write .",
    "check-format": "biome format .",
    "test": "bun run clean-test-temp && vitest run --project unit",
    "test:snapshots": "bun run clean-test-temp && vitest run --project unit --update",
    "codegen:clean": "find src -name '*.generated.ts' -delete",
    "codegen": "bun run codegen:clean && export GRAPHQL_AUTH_KEY=$(FORCE_HUMAN_MODE=true prism me:token | node scripts/read-codegen-token.mjs) && export PRISMATIC_URL=$(echo $PRISMATIC_URL) && graphql-codegen --config codegen.ts && bun run format",
    "test:cli": "vitest run --project cli",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "files": [
    "bin",
    "lib"
  ],
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@modelcontextprotocol/server": "2.0.0-alpha.4",
    "@msgpack/msgpack": "^3.1.3",
    "chardet": "^2.1.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "fs-extra": "^11.3.5",
    "graphql": "^16.14.0",
    "http-status-codes": "^2.3.0",
    "incur": "^0.5.1",
    "inquirer": "^14.2.2",
    "inquirer-autocomplete-standalone": "^0.8.1",
    "js-yaml": "^5.1.0",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "mime-types": "^3.0.2",
    "natural-orderby": "^5.0.0",
    "number-to-words": "^1.2.4",
    "open": "^11.0.0",
    "prettier": "^3.8.3",
    "striptags": "^3.2.0",
    "tempy": "^3.2.0",
    "terminal-link": "^5.0.0",
    "tinyexec": "^1.1.2",
    "tinyglobby": "^0.2.16",
    "ts-morph": "^28.0.0",
    "undici": "^8.10.2",
    "uuid": "^14.0.0",
    "wsdl-tsclient": "^1.7.1",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/near-operation-file-preset": "^5.2.2",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@prismatic-io/spectral": "^10.22.0",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.0.0",
    "@types/number-to-words": "^1.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "bun-types": "^1.3.14",
    "chalk": "^6.0.0",
    "msw": "^2.14.6",
    "openapi-types": "^12.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "yauzl": "^3.3.0"
  }
}
